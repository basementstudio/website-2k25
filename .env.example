# Copy to `.env.local` and fill in. Never commit real values.

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Optional, defaults to the version pinned in sanity/env.ts
NEXT_PUBLIC_SANITY_API_VERSION=
# Server-side read token — powers server draft fetches & live tag sync.
SANITY_READ_TOKEN=
# Shipped to the browser ONLY during draft/preview sessions, so it must be a
# Viewer-scoped token (never the read token above). Must be set in Vercel
# (Preview + Production) for live draft preview to work.
SANITY_BROWSER_TOKEN=
# Token used by the Studio / write operations.
SANITY_API_TOKEN=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Postgres ---
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# --- Email / newsletter ---
MAILCHIMP_API_KEY=
MAILCHIMP_API_SERVER=
MAILCHIMP_LIST_ID=
RESEND_API_KEY=

# --- Content sources ---
BASEHUB_TOKEN=
NOTION_API_KEY=
NOTION_CAREERS_DB_ID=
NOTION_CAREERS_PARENT_PAGE_ID=

# --- Mux (video) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# --- PostHog analytics ---
# Must be exactly "true" to enable analytics; anything else keeps it off.
NEXT_PUBLIC_POSTHOG_ENABLED=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_CLI_ENV_ID=
POSTHOG_CLI_TOKEN=
