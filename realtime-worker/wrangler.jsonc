{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "basement-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  // The Workers Free plan only allows SQLite-backed Durable Objects
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://basement.studio,.vercel.app,http://localhost:3000"
  },
  "observability": { "enabled": true }
}
